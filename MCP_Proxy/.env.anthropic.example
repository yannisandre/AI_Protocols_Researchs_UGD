# Copy to .env.anthropic (ignored), chmod 600, then fill locally.
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
# Exact Claude model ID available to your API account; no automatic fallback.
LLM_MODEL=
ANTHROPIC_VERSION=2026-10-21
LLM_MAX_COMPLETION_TOKENS=800
LLM_MAX_REQUESTS=6
