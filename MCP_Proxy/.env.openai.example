# Copy to .env.openai (ignored), chmod 600, then fill locally. Never paste a key in chat.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Exact model ID supporting Chat Completions function tools; no automatic fallback.
LLM_MODEL=
LLM_MAX_COMPLETION_TOKENS=800
LLM_MAX_REQUESTS=6
