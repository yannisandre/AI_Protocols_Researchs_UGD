# Optional judge settings: append these fields to the selected ignored actor .env file.
# Blank provider/key/model use the actor configuration with a separate conversation and limits.
# A different GUARD_PROVIDER requires its own explicit GUARD_MODEL and GUARD_API_KEY.
GUARD_PROVIDER=
GUARD_BASE_URL=
GUARD_MODEL=
GUARD_API_KEY=
GUARD_MAX_COMPLETION_TOKENS=256
GUARD_MAX_REQUESTS=4
GUARD_ANTHROPIC_VERSION=2026-10-21
