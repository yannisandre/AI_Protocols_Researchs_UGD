# Required only for --driver llm. Never commit .env or a real key.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
# Select a model supporting Chat Completions function tools.
LLM_MODEL=
# Maximum generated tokens per API request; no automatic paid retries.
LLM_MAX_COMPLETION_TOKENS=1500
LLM_MAX_REQUESTS=8
